<Window x:Class="StickyNotes.RemindersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reminders"
        Width="380" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#FAFAFA"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Reminders for this note" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />

        <!-- Existing reminders list -->
        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" Background="White" CornerRadius="4">
            <Grid>
                <ListBox x:Name="RemindersList" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="6,4">
                                <Button DockPanel.Dock="Right" FontFamily="{StaticResource IconFont}" Content="&#xE74D;"
                                        Width="26" Height="26" Background="Transparent" BorderThickness="0"
                                        Foreground="#888" Cursor="Hand" ToolTip="Delete reminder"
                                        Click="DeleteReminder_Click" Tag="{Binding}" />
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RecurrenceText}" FontSize="11" Foreground="#666" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="No reminders set for this note." Foreground="#888"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Add new reminder section -->
        <Border Grid.Row="2" Background="#F0F0F0" CornerRadius="4" Padding="10" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Add Reminder" FontWeight="SemiBold" Margin="0,0,0,6" />
                <!-- Date and Time row -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <DatePicker x:Name="ReminderDatePicker" Grid.Column="0" VerticalContentAlignment="Center" />

                    <!-- Time input: Hour : Minute with up/down spinner buttons -->
                    <Border Grid.Column="2" Background="White" BorderBrush="#ABADB3" BorderThickness="1" CornerRadius="2" Padding="4,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="HourText" Width="26" BorderThickness="0" Background="Transparent"
                                     TextAlignment="Center" VerticalContentAlignment="Center" MaxLength="2"
                                     PreviewTextInput="TimeBox_PreviewTextInput"
                                     PreviewKeyDown="HourText_PreviewKeyDown"
                                     LostFocus="HourText_LostFocus" />
                            <TextBlock Text=":" VerticalAlignment="Center" FontWeight="Bold" Margin="1,0" Foreground="#555" />
                            <TextBox x:Name="MinuteText" Width="26" BorderThickness="0" Background="Transparent"
                                     TextAlignment="Center" VerticalContentAlignment="Center" MaxLength="2"
                                     PreviewTextInput="TimeBox_PreviewTextInput"
                                     PreviewKeyDown="MinuteText_PreviewKeyDown"
                                     LostFocus="MinuteText_LostFocus" />

                            <!-- Spin buttons -->
                            <StackPanel Margin="4,0,0,0" VerticalAlignment="Center">
                                <Button x:Name="TimeUpBtn" Width="16" Height="10" Padding="0" Margin="0,0,0,1"
                                        Background="#E8E8E8" BorderThickness="0" Focusable="False"
                                        Click="TimeUp_Click" ToolTip="Increase minute (Up arrow)">
                                    <Path Data="M 0 3 L 3 0 L 6 3 Z" Fill="#555" Stretch="Uniform" Width="6" Height="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                                <Button x:Name="TimeDownBtn" Width="16" Height="10" Padding="0"
                                        Background="#E8E8E8" BorderThickness="0" Focusable="False"
                                        Click="TimeDown_Click" ToolTip="Decrease minute (Down arrow)">
                                    <Path Data="M 0 0 L 3 3 L 6 0 Z" Fill="#555" Stretch="Uniform" Width="6" Height="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <CheckBox x:Name="RecurringCheck" Content="Repeat daily at this time" Margin="0,2,0,8"
                          Checked="RecurringCheck_Changed" Unchecked="RecurringCheck_Changed" />

                <Button x:Name="AddButton" Content="Add Reminder" HorizontalAlignment="Right"
                        Padding="12,4" Click="AddReminder_Click" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="Close" HorizontalAlignment="Right" Padding="16,5" IsDefault="True" Click="Close_Click" />
        </DockPanel>
    </Grid>
</Window>
