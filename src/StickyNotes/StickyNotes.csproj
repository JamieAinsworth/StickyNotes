<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>StickyNotes</AssemblyName>
    <RootNamespace>StickyNotes</RootNamespace>
    <Product>Sticky Notes</Product>
    <Version>1.1.0</Version>
    <ApplicationIcon>Assets\StickyNotes.ico</ApplicationIcon>
    <!-- WPF owns the process, so per-monitor DPI is declared in app.manifest. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- Local builds skip the StickyNotes.exe launcher because Defender flags the unsigned apphost on
         some machines; they run as "dotnet StickyNotes.dll". build.ps1 sets UseAppHost=true for the
         self-contained exe and installer. -->
    <UseAppHost Condition="'$(UseAppHost)' == ''">false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StickyNotes.Tests" />
  </ItemGroup>

</Project>
