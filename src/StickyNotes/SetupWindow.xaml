<Window x:Class="StickyNotes.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sticky Notes setup"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Colour swatch: a RadioButton drawn as a mini note -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="Colour" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Outer" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Padding="2"
                                Background="Transparent">
                            <Border CornerRadius="3" BorderBrush="#33000000" BorderThickness="1" ClipToBounds="True"
                                    Background="{Binding BodyBrush}">
                                <Grid>
                                    <Border Height="9" VerticalAlignment="Top" Background="{Binding HeaderBrush}" />
                                    <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="14" Foreground="#C0000000" Margin="0,6,0,0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#40000000" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#60000000" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#B0000000" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="MinWidth" Value="84" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" Text="Welcome to Sticky Notes" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="Intro" Margin="0,4,0,18" TextWrapping="Wrap" Foreground="#555"
                   Text="Pick a few defaults to get started. You can change these later from the tray icon's Settings menu." />

        <!-- Default colour -->
        <TextBlock Text="Default note colour" Style="{StaticResource SectionTitle}" />
        <ItemsControl x:Name="ColourList" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton Style="{StaticResource Swatch}" ToolTip="{Binding Name}"
                                 AutomationProperties.Name="{Binding Name}"
                                 Checked="Swatch_Checked" Loaded="Swatch_Loaded" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="ColourName" Margin="0,6,0,0" Foreground="#555" />

        <!-- Data folder -->
        <TextBlock Text="Where to save your notes" Style="{StaticResource SectionTitle}" Margin="0,20,0,8" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click" />
            <TextBox x:Name="FolderBox" VerticalContentAlignment="Center" Padding="4,3"
                     AutomationProperties.Name="Notes folder" TextChanged="FolderBox_TextChanged" />
        </DockPanel>
        <DockPanel Margin="0,6,0,0">
            <Button x:Name="UseDefaultButton" DockPanel.Dock="Right" Content="Use default" Padding="8,2" MinWidth="0"
                    VerticalAlignment="Top" Margin="8,0,0,0" Click="UseDefault_Click" />
            <TextBlock x:Name="FolderHint" TextWrapping="Wrap" Foreground="#555" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Startup -->
        <TextBlock Text="Start with Windows" Style="{StaticResource SectionTitle}" Margin="0,20,0,8" />
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="StartupYes" GroupName="Startup" Content="Yes, open my notes when I sign in"
                         Margin="0,0,20,0" />
            <RadioButton x:Name="StartupNo" GroupName="Startup" Content="No" />
        </StackPanel>

        <!-- Hotkeys -->
        <TextBlock Text="Global shortcuts" Style="{StaticResource SectionTitle}" Margin="0,20,0,8" />

        <TextBlock Text="Show / hide all notes" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Clear" Margin="8,0,0,0" Click="ClearHotkey_Click" />
            <TextBox x:Name="HotkeyBox" IsReadOnly="True" VerticalContentAlignment="Center" Padding="4,3"
                     AutomationProperties.Name="Show or hide notes hotkey"
                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
        </DockPanel>
        <TextBlock Margin="0,4,0,10" TextWrapping="Wrap" Foreground="#555" FontSize="12"
                   Text="Brings notes in front of other windows, or returns them to the desktop (e.g. Ctrl+Alt+N)." />

        <TextBlock Text="New note" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Clear" Margin="8,0,0,0" Click="ClearNewNoteHotkey_Click" />
            <TextBox x:Name="NewNoteHotkeyBox" IsReadOnly="True" VerticalContentAlignment="Center" Padding="4,3"
                     AutomationProperties.Name="New note hotkey"
                     PreviewKeyDown="NewNoteHotkeyBox_PreviewKeyDown" />
        </DockPanel>
        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#555" FontSize="12"
                   Text="Creates a new sticky note from anywhere in Windows (e.g. Ctrl+Alt+M)." />

        <TextBlock x:Name="ErrorText" Margin="0,16,0,0" Foreground="#B00020" TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="SaveButton" Content="Get started" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
